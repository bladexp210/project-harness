# Copy to .env and fill — never commit .env (gitleaks + gitignore).
# Setup walkthrough: ../track-a-setup.md
#
# You do NOT install LiteLLM or Langfuse separately — Docker Compose starts them.

# --- OpenRouter (upstream provider) ---
# Paste your key from https://openrouter.ai/keys (scoped + credit limit).
OPENROUTER_API_KEY=YOUR_OPENROUTER_KEY

# --- LiteLLM (runs in Docker — fill BEFORE first "docker compose up") ---
# LITELLM_MASTER_KEY = Command A in track-a-setup.md → paste after =
LITELLM_MASTER_KEY=YOUR_LITELLM_MASTER_KEY
# LITELLM_SALT_KEY   = Command B in track-a-setup.md → paste after = (DIFFERENT string)
LITELLM_SALT_KEY=...

# --- LiteLLM database (local Postgres in docker-compose — not installed on Windows) ---
POSTGRES_PASSWORD=YOUR_LOCAL_ONLY_PASSWORD

# --- Langfuse (S27 — fill BEFORE first "docker compose up") ---
# Generate once; do NOT rotate after first boot (invalidates encrypted data).
# Command C/D/E in track-a-setup.md § Observability
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_SALT=
LANGFUSE_ENCRYPTION_KEY=
# Optional dev defaults for backing services (change in production):
LANGFUSE_POSTGRES_PASSWORD=YOUR_LOCAL_ONLY_PASSWORD
LANGFUSE_CLICKHOUSE_PASSWORD=YOUR_LOCAL_ONLY_PASSWORD
LANGFUSE_REDIS_AUTH=YOUR_LOCAL_ONLY_PASSWORD
LANGFUSE_MINIO_USER=langfuse-minio
LANGFUSE_MINIO_PASSWORD=YOUR_LOCAL_ONLY_PASSWORD
LANGFUSE_NEXTAUTH_URL=http://localhost:3001
# First-run admin (optional — Langfuse creates org/project on first boot):
# LANGFUSE_INIT_USER_EMAIL=dev@localhost
# LANGFUSE_INIT_USER_NAME=dev
# LANGFUSE_INIT_USER_PASSWORD=...
# After Langfuse UI loads → Settings → API Keys → paste here → restart litellm:
LANGFUSE_PUBLIC_KEY=YOUR_LANGFUSE_PUBLIC_KEY
LANGFUSE_SECRET_KEY=YOUR_LANGFUSE_SECRET_KEY

# --- Workspace mount (session worktree or single-clone ramp) ---
# Windows Docker Desktop — forward slashes:
# WORKSPACE_PATH=/Users/you/src/project-harness
WORKSPACE_PATH=/path/to/your/session-worktree
# SANDBOX_VOLUMES is set in docker-compose.yml from WORKSPACE_PATH — override only if needed:
# SANDBOX_VOLUMES=/Users/you/src/project-harness:/workspace/project:rw

# --- OpenHands images (optional — defaults in docker-compose.yml) ---
# Pin versions from https://docs.openhands.dev/openhands/usage/run-openhands/local-setup
# OPENHANDS_IMAGE=ghcr.io/openhands/openhands:1.8
# AGENT_SERVER_IMAGE_REPOSITORY=ghcr.io/openhands/agent-server
# AGENT_SERVER_IMAGE_TAG=1.26.0-python
# CDN mirror if ghcr.io is slow: docker.openhands.dev/openhands/openhands:1.8

# --- OpenHands state (persisted outside repo) ---
OPENHANDS_STATE_DIR=./.openhands-state
